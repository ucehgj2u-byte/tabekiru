{
  "name": "food-loss-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply food-loss-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply food-loss-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
